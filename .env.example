# Upstream vLLM Server Settings (e.g. Colab Cloudflare Quick Tunnel)
VLLM_BASE_URL=https://YOUR-TUNNEL.trycloudflare.com/v1
VLLM_API_KEY=dev-secret
VLLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# Gateway Server Settings
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=9000

# Client API Keys (comma-separated list of pre-authorized keys)
GATEWAY_API_KEYS=sk-antigravity-dev-key,sk-test-client-key
GATEWAY_ADMIN_KEY=admin-secret-key
